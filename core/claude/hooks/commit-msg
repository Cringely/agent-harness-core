#!/bin/sh
# Git commit-msg hook. Refuses any commit message carrying AI attribution,
# and any commit message without a rationale line (see "WHY LINE" below).
#
# WHY THIS EXISTS
# change-management.md: "All commits must use the user's GitHub identity only.
# Never add Claude as a co-author or include any Co-Authored-By trailer."
# On 2026-09-04 thirteen commits on feat/account-layer-portability picked up
# Co-Authored-By and Claude-Session trailers anyway, because the rule was
# followed by the orchestrator and never propagated into the subagent briefs
# that were doing the committing. They had to be stripped with filter-branch.
# A rule that lives only in a briefing is a rule that holds only while every
# briefing remembers it.
#
# WHY A GIT HOOK
# Same argument as hooks/pre-commit: git runs on every commit no matter who
# or what made it. Subagents commit, scripts commit, humans commit. A Claude
# Code PreToolUse matcher on Bash would have to spawn a process on every Bash
# call to string-match "git commit", and Bash is the hottest tool in a
# session.
#
# ESCAPE HATCH
# The trailer checks are anchored to the start of a line, because that is
# where git trailers live. To write one of these strings in prose (a commit
# that documents this rule, for instance), indent it by two spaces.

# WHY LINE
# change-management-code.md asks every commit message to say why the change was
# needed. Asked in prose only, that held for the commits whose author remembered
# and lapsed for the rest, so the hook now requires one line starting with
# "Why:" (any case) followed by at least three words. Exempt, because git or a
# convention writes the message and there is nothing to add:
#   - merge commits (a MERGE_HEAD exists, or the subject starts "Merge ")
#   - reverts made by git revert (subject starts: Revert " or Reapply ")
#   - fixup!, squash! and amend! subjects
#   - subject-only commits typed docs, chore or style
# Only the refusal reason is printed. A message that fails both this check and
# an attribution check is refused for attribution first.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# Strip comment lines git will discard anyway, so a commented-out template
# cannot trip the gate. Then drop lines indented two or more spaces: that is
# the documented way to write one of these strings as prose, and dropping them
# once here is what lets the checks below stay simple.
scan=$(grep -v '^#' "$msg_file" | grep -v '^  ')

fail() {
    echo "commit-msg: refused. $1" >&2
    echo "" >&2
    echo "  change-management.md: commits carry the operator's identity only." >&2
    echo "  No Co-Authored-By naming Claude or Anthropic, no Claude-Session," >&2
    echo "  no 'Generated with Claude Code', no anthropic.com address." >&2
    echo "" >&2
    echo "  To write one of these strings in prose, indent the line by two spaces." >&2
    exit 1
}

printf '%s\n' "$scan" | grep -qiE '^Co-authored-by:.*(claude|anthropic)' &&
    fail "Co-Authored-By trailer naming Claude or Anthropic."

printf '%s\n' "$scan" | grep -qiE '^Claude-Session:' &&
    fail "Claude-Session trailer."

printf '%s\n' "$scan" | grep -qiE 'generated with .{0,4}\[?claude code' &&
    fail "'Generated with Claude Code' attribution line."

printf '%s\n' "$scan" | grep -qiE '(noreply@anthropic\.com|claude\.ai/code/session)' &&
    fail "Anthropic address or Claude session URL."


# --- Why line -------------------------------------------------------------
# Plain shell with no external process on the common path: a commit runs this
# hook every time, and process spawns are what make a hook slow on Windows.

cr=$(printf '\r')
subject=
has_body=0
has_why=0
set -f
while IFS= read -r line || [ -n "$line" ]; do
    line=${line%"$cr"}
    case "$line" in '#'*) continue ;; esac
    case "$line" in *[![:space:]]*) ;; *) continue ;; esac
    if [ -z "$subject" ]; then
        subject=$line
        continue
    fi
    has_body=1
    case "$line" in
        [Ww][Hh][Yy]:*)
            # Unquoted on purpose: word splitting counts the words after the colon.
            set -- ${line#*:}
            [ "$#" -ge 3 ] && has_why=1
            ;;
    esac
done < "$msg_file"
set +f

[ "$has_why" -eq 1 ] && exit 0

# Exemptions.
case "$subject" in
    "Merge "* | 'Revert "'* | 'Reapply "'* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac
if [ "$has_body" -eq 0 ]; then
    case "$subject" in
        docs:* | docs!:* | docs\(*\):* | docs\(*\)!:* | \
        chore:* | chore!:* | chore\(*\):* | chore\(*\)!:* | \
        style:* | style!:* | style\(*\):* | style\(*\)!:*) exit 0 ;;
    esac
fi
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0

echo "commit-msg: refused. No 'Why:' line with at least three words. Add one, e.g. 'Why: the retry loop spun without backoff.'" >&2
exit 1
