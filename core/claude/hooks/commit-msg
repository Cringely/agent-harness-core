#!/bin/sh
# Git commit-msg hook. Refuses any commit message carrying AI attribution,
# and any commit message without a rationale line (see "WHY LINE" below).
#
# WHY THIS EXISTS
# change-management.md: "All commits must use the user's GitHub identity only.
# Never add Claude as a co-author or include any Co-Authored-By trailer."
# On 2026-09-04 thirteen commits on feat/account-layer-portability picked up
# Co-Authored-By and Claude-Session trailers anyway, because the rule was
# followed by the orchestrator and never propagated into the subagent briefs
# that were doing the committing. They had to be stripped with filter-branch.
# A rule that lives only in a briefing is a rule that holds only while every
# briefing remembers it.
#
# WHY A GIT HOOK
# Same argument as hooks/pre-commit: git runs on every commit no matter who
# or what made it. Subagents commit, scripts commit, humans commit. A Claude
# Code PreToolUse matcher on Bash would have to spawn a process on every Bash
# call to string-match "git commit", and Bash is the hottest tool in a
# session.
#
# ESCAPE HATCH
# The trailer checks are anchored to the start of a line, because that is
# where git trailers live. To write one of these strings in prose (a commit
# that documents this rule, for instance), indent it by two spaces.

# WHY LINE
# change-management-code.md asks every commit message to say why the change was
# needed. Asked in prose only, that held for the commits whose author remembered
# and lapsed for the rest, so the hook requires one line starting with "Why:"
# (any case) followed by at least three words, on a message that has a body.
# It enforces this only when no editor ran (git commit -m, -F, --no-edit), and
# judges the raw message file as given. An editor commit skips the check: what
# the editor leaves behind depends on cleanup rules a hook cannot see. Exempt:
#   - subject-only commits of any type: nothing after the subject but blank
#     lines and trailers whose key holds a hyphen (Signed-off-by:, Reviewed-by:)
#   - merge commits (a MERGE_HEAD exists, or the subject is one git writes:
#     "Merge branch ", "Merge branches ", "Merge remote-tracking branch ",
#     "Merge pull request ", "Merge tag ", "Merge commit ")
#   - reverts made by git revert (subject starts: Revert " or Reapply ")
#   - fixup!, squash! and amend! subjects
# Only the refusal reason is printed. A message that fails both this check and
# an attribution check is refused for attribution first.

msg_file="$1"
[ -f "$msg_file" ] || exit 0

# --- Binary input -----------------------------------------------------------
# grep drops to binary mode on a NUL byte or on bytes invalid in the locale and
# prints "Binary file ... matches" in place of the lines, so the scans below
# would read the wrong text. Every grep here runs as LC_ALL=C grep -a, which
# treats the file as plain bytes. A NUL byte cannot be held in a shell variable
# at all, and git cannot store one in a commit message cleanly, so refuse it.
if ! tr -d '\000' < "$msg_file" | cmp -s - "$msg_file"; then
    echo "commit-msg: refused. The message holds a NUL byte, which git cannot store in a commit message." >&2
    exit 1
fi

# --- Attribution ------------------------------------------------------------
# Scanned over the whole raw file: comment lines, the scissors line and
# everything below it included. Which of those lines git keeps depends on
# flags a hook cannot see (-v, --cleanup), and cutting where git does not
# would let a trailer below a hand-typed scissors line through. Scanning the
# lines git throws away as well costs only a false refusal: a verbose diff
# (git commit -v) whose staged content carries one of these strings is
# refused. Commit without -v in that case.
#
# Lines indented two or more spaces are dropped first: that is the documented
# way to write one of these strings as prose.
scan=$(LC_ALL=C grep -a -v '^  ' "$msg_file")

fail() {
    echo "commit-msg: refused. $1" >&2
    echo "" >&2
    echo "  change-management.md: commits carry the operator's identity only." >&2
    echo "  No Co-Authored-By naming Claude or Anthropic, no Claude-Session," >&2
    echo "  no 'Generated with Claude Code', no anthropic.com address." >&2
    echo "" >&2
    echo "  To write one of these strings in prose, indent the line by two spaces." >&2
    exit 1
}

printf '%s\n' "$scan" | LC_ALL=C grep -aqiE '^Co-authored-by:.*(claude|anthropic)' &&
    fail "Co-Authored-By trailer naming Claude or Anthropic."

printf '%s\n' "$scan" | LC_ALL=C grep -aqiE '^Claude-Session:' &&
    fail "Claude-Session trailer."

printf '%s\n' "$scan" | LC_ALL=C grep -aqiE 'generated with .{0,4}\[?claude code' &&
    fail "'Generated with Claude Code' attribution line."

printf '%s\n' "$scan" | LC_ALL=C grep -aqiE '(noreply@anthropic\.com|claude\.ai/code/session)' &&
    fail "Anthropic address or Claude session URL."

# --- Why line: no-editor commits only -------------------------------------
# git sets GIT_EDITOR to ":" for the hook when it used no editor. Any other value
# means an editor ran, and the Why line is expected there but not enforced.
#
# The raw file is judged with no model of git's cleanup: every non-blank line
# after the subject is body, comment lines and a typed scissors line included,
# except a trailer whose key holds a hyphen. Without an editor git keeps
# comment lines unless commit.cleanup=strip is set, so the raw file is close to
# what git stores. Under commit.cleanup=strip a #-led body line still needs a
# Why line, and a caller who sets GIT_EDITOR=: for an editor-mode commit (git
# commit --amend) has the template's comment lines read as body. Use --no-edit
# there.
[ "${GIT_EDITOR-}" = ":" ] || exit 0
cr=$(printf '\r')

# needs_why: exit 0 when the message has a body, no qualifying Why line, and no
# exempt subject. One pass over the file, with no external process: a commit
# runs this hook every time, and process spawns are what make a hook slow on
# Windows.
needs_why() {
    subject=
    has_body=0
    has_why=0
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%"$cr"}
        case "$line" in *[![:space:]]*) ;; *) continue ;; esac
        if [ -z "$subject" ]; then
            subject=$line
            continue
        fi
        # A trailer whose key holds a hyphen (Signed-off-by:) is not a body.
        key=${line%%: *}
        case "$key" in
            "$line" | -* | *[!A-Za-z0-9-]*) has_body=1 ;;
            *-*) ;;
            *) has_body=1 ;;
        esac
        case "$line" in
            [Ww][Hh][Yy]:*)
                # Unquoted on purpose: word splitting counts the words after the colon.
                set -- ${line#*:}
                [ "$#" -ge 3 ] && has_why=1
                ;;
        esac
    done < "$msg_file"
    [ "$has_why" -eq 1 ] && return 1
    [ "$has_body" -eq 0 ] && return 1
    case "$subject" in
        "Merge branch "* | "Merge branches "* | "Merge remote-tracking branch "* | "Merge pull request "* | \
        "Merge tag "* | "Merge commit "* | \
        'Revert "'* | 'Reapply "'* | "fixup! "* | "squash! "* | "amend! "*) return 1 ;;
    esac
    return 0
}

set -f
needs_why || exit 0
set +f
git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1 && exit 0

echo "commit-msg: refused. No 'Why:' line with at least three words. Add one, e.g. 'Why: the retry loop spun without backoff.'" >&2
exit 1
