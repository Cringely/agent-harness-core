{
  "mcpServers": {
    "1password": {
      "type": "stdio",
      "command": "C:\\Users\\user\\AppData\\Local\\Microsoft\\WindowsApps\\1password-mcp.exe",
      "args": [],
      "env": {}
    },
    "code-context": {
      "type": "stdio",
      "command": "wsl",
      "args": [
        "-e",
        "{{WSL_HOME}}/code-context-mcp.sh"
      ],
      "env": {}
    },
    "acme": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--python",
        "3.12",
        "--with",
        "mcp<2.0",
        "--from",
        "git+https://example.invalid/acme_mcp",
        "acme-mcp"
      ],
      "env": {}
    }
  }
}
